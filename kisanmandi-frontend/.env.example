# KisanMandi Frontend Environment Variables Example
# Local development backend API:
VITE_API_BASE_URL=http://localhost:8080/api

# Production Render backend API (set in Vercel project settings):
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# OPTIONAL: Public Demo Accounts for Recruiter/Showcase Quick-Login
# NOTE: Any variable prefixed with VITE_* is bundled into client code and publicly visible in the browser.
# Only use non-sensitive, public demo credentials here. Never add admin or production credentials!
# VITE_DEMO_CUSTOMER_EMAIL=
# VITE_DEMO_CUSTOMER_PASSWORD=
# VITE_DEMO_FARMER_EMAIL=
# VITE_DEMO_FARMER_PASSWORD=
