# ─── Database ───────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=YOUR_DB_PASSWORD

# ─── JWT (MUST be at least 32 characters long) ─────────
JWT_SECRET=your_random_jwt_secret_at_least_32_characters_long

# ─── Admin Seeder (this admin is auto-created on startup) ──
ADMIN_EMAIL=admin@kisanmandi.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# ─── Cloudinary ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ─── Mandi API ──────────────────────────────────────────
MANDI_API_KEY=YOUR_DATA_GOV_IN_KEY
mandi.demo-seed.enabled=false
